DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/TON_ID/TON_TOKEN
CROUS_URL=https://trouverunlogement.lescrous.fr/tools/47/search?bounds=...
# Optionnel: surveiller plusieurs villes (separees par des virgules)
# CROUS_URLS=https://trouverunlogement.lescrous.fr/tools/47/search?bounds=...Nancy...,https://trouverunlogement.lescrous.fr/tools/47/search?bounds=...Lille...
# Intervalle entre deux scans (secondes). 5 = latence minimale théorique de 5 s.
CHECK_INTERVAL=5
# Nombre de scans consécutifs sans le logement avant de le marquer « déjà pris ».
MISS_THRESHOLD=2
LOG_LEVEL=INFO
NOTIFY_EXISTING_ON_STARTUP=true
# Optionnel: chemin de la base SQLite qui conserve l'état entre les redémarrages.
# STATE_DB_PATH=data/alert_crous.sqlite3
